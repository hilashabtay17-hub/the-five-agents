# ============================================
# .env.example - תבנית למשתני סביבה
# ============================================
# העתיקי את הקובץ הזה ל-.env ומלאי את הערכים האמיתיים.
# הקובץ .env לא יעלה ל-git (מופיע ב-.gitignore).
# ============================================

# --- Anthropic / Claude API ---
# נדרש כדי להריץ את הצוות (ראובן + יעל + יובל + חן).
# מקבלים מ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- יובל (מעצב התמונות) ---
# מפתח ליצירת תמונות. אם משתמשים ב-OpenAI DALL-E:
OPENAI_API_KEY=
# או אם משתמשים בשירות אחר, להוסיף כאן (Replicate, Stability וכו')

# --- חן (החוקרת) ---
# מפתח לחיפוש באינטרנט. אופציות נפוצות:
# Tavily: https://tavily.com
TAVILY_API_KEY=
# או Brave Search / Serper / SerpAPI - להוסיף לפי הבחירה

# --- כללי ---
# סביבת ריצה: development / production
NODE_ENV=development
